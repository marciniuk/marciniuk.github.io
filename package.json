{
  "name": "marcini.uk",
  "type": "module",
  "version": "3.2.0",
  "description": "Strona powstała pod wpływem kofeiny oraz zbyt dużej ilości wolnego czasu.",
  "main": "index.html",
  "scripts": {
    "build": "tailwindcss -i ./input.css -o ./assets/css/main.css --minify && node generate-sitemap.js",
    "dev": "tailwindcss -i ./input.css -o ./assets/css/main.css --watch",
    "imgopti": "esbuild assets/js/img-opti.js --bundle --format=esm --outfile=assets/js/img-opti.bundle.js && npm run imgopti:wasm",
    "imgopti:wasm": "node assets/js/copy-wasm.js",
    "head": "node assets/replace/replace-heads.js",
    "footer": "node assets/replace/replace-footers.js",
    "header": "node assets/replace/replace-headers.js",
    "full": "node assets/replace/html-structure.js",
    "format": "node prettier-summary.js",
    "cliF": "prettier --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marciniuk/marciniuk.github.io.git"
  },
  "author": "Marcini.uk",
  "license": "ISC",
  "homepage": "https://marcini.uk",
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.18",
    "esbuild": "^0.28.2",
    "sitemap": "^9.0.0",
    "tailwind-rounded-out": "^2.0.0",
    "tailwind-scrollbar": "^4.0.0",
    "tailwindcss": ">=4.0.0",
    "xml-formatter": "^3.6.7"
  },
  "dependencies": {
    "@jsquash/avif": "^2.1.1",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/jxl": "^1.3.0",
    "@jsquash/oxipng": "^2.3.0",
    "@jsquash/webp": "^1.5.0",
    "jszip": "^3.10.1",
    "prettier": "^3.6.2"
  }
}
